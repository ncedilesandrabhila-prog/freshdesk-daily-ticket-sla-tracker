      ],
      "id": "ce9fdd2c-16ed-4cd9-9f14-0dd8a63537df",
      "name": "Daily Ticket Summary code"
    },
    {
      "parameters": {
        "jsCode": "// --------------------------------\n// STATUS MAPPINGS\n// --------------------------------\n\nconst statusNames = {\n  2: \"Open\",\n  3: \"Pending\",\n  4: \"Resolved\",\n  5: \"Closed\",\n  6: \"Waiting on Customer\"\n};\n\n\n// --------------------------------\n// DATE / TIME ZONE\n// --------------------------------\n\nconst timeZone = \"Africa/Johannesburg\";\n\n// Date when the change was detected\nconst dateChecked = new Intl.DateTimeFormat(\"en-GB\", {\n  timeZone,\n  day: \"2-digit\",\n  month: \"2-digit\",\n  year: \"numeric\"\n}).format(new Date());\n\n\n// --------------------------------\n// PROCESS MERGED TICKETS\n// --------------------------------\n\nconst tickets = $input.all();\n\nconst changes = [];\n\nfor (const item of tickets) {\n\n  const data = item.json;\n\n  // --------------------------------\n  // GOOGLE SHEETS INFORMATION\n  // --------------------------------\n\n  const ticketId = data[\"Ticket ID\"];\n  const subject = data[\"Subject\"] || \"\";\n  const owner = data[\"Owner\"] || \"\";\n  const previousStatus = data[\"Status\"] || \"\";\n\n\n  // --------------------------------\n  // FRESHDESK INFORMATION\n  // --------------------------------\n\n  const currentStatus =\n    statusNames[data.status] || data.status || \"\";\n\n  const createdAt = data.created_at;\n\n\n  // --------------------------------\n  // CREATED DATE\n  // --------------------------------\n\n  let createdDate = \"\";\n\n  if (createdAt) {\n    createdDate = new Intl.DateTimeFormat(\"en-GB\", {\n      timeZone,\n      day: \"2-digit\",\n      month: \"2-digit\",\n      year: \"numeric\"\n    }).format(new Date(createdAt));\n  }\n\n\n  // --------------------------------\n  // CHECK FOR STATUS CHANGE\n  // --------------------------------\n\n  if (\n    ticketId &&\n    previousStatus &&\n    currentStatus &&\n    previousStatus !== currentStatus\n  ) {\n\n    let changeType = \"Status changed\";\n\n\n    // Identify reopened tickets\n    if (\n      (previousStatus === \"Resolved\" || previousStatus === \"Closed\") &&\n      currentStatus === \"Open\"\n    ) {\n      changeType = \"Reopened\";\n    }\n\n\n    // Freshdesk ticket link\n    const ticketLink =\n      `https://boxfusion.freshdesk.com/a/tickets/${ticketId}`;\n\n\n    // --------------------------------\n    // OUTPUT\n    // --------------------------------\n\n    changes.push({\n      json: {\n        \"Date Checked\": dateChecked,\n        \"Ticket ID\": ticketId,\n        \"Subject\": subject,\n        \"Created Date\": createdDate,\n        \"Change\": changeType,\n        \"Previous Status\": previousStatus,\n        \"New Status\": currentStatus,\n        \"Owner\": owner,\n        \"Ticket Link\": ticketLink\n      }\n    });\n  }\n}\n\n\n// --------------------------------\n// RETURN CHANGES\n// --------------------------------\n\nreturn changes;"
      },
