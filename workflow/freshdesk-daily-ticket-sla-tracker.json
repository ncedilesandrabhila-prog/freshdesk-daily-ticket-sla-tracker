    {
      "parameters": {
        "jsCode": "const timeZone = \"Africa/Johannesburg\";\n\n// Today's date in South African time\nconst today = new Intl.DateTimeFormat(\"en-CA\", {\n  timeZone,\n  year: \"numeric\",\n  month: \"2-digit\",\n  day: \"2-digit\"\n}).format(new Date());\n\nconst tickets = $input.all()\n  .filter(item => {\n    if (!item.json.created_at) return false;\n\n    const createdDate = new Intl.DateTimeFormat(\"en-CA\", {\n      timeZone,\n      year: \"numeric\",\n      month: \"2-digit\",\n      day: \"2-digit\"\n    }).format(new Date(item.json.created_at));\n\n    return createdDate === today;\n  })\n  .map(item => {\n\n    // --------------------------------\n    // STATUS\n    // --------------------------------\n\n    const statusNames = {\n      2: \"Open\",\n      3: \"Pending\",\n      4: \"Resolved\",\n      5: \"Closed\"\n    };\n\n    if (statusNames[item.json.status]) {\n      item.json.status = statusNames[item.json.status];\n    }\n\n\n    // --------------------------------\n    // PRIORITY\n    // --------------------------------\n\n    const priorityNames = {\n      1: \"Low\",\n      2: \"Medium\",\n      3: \"High\",\n      4: \"Urgent\"\n    };\n\n    if (priorityNames[item.json.priority]) {\n      item.json.priority = priorityNames[item.json.priority];\n    }\n\n\n    // --------------------------------\n    // GROUP NAME\n    // --------------------------------\n\n    const groupNames = {\n      \"9000177886\": \"Matateni\",\n      \"9000177884\": \"Centurion\"\n    };\n\n    item.json.group =\n      groupNames[item.json.group_id] || \"\";\n\n\n    // --------------------------------\n    // IS ESCALATED\n    // --------------------------------\n\n    item.json.is_escalated =\n      item.json.nr_escalated === true ? \"YES\" : \"NO\";\n\n\n    // --------------------------------\n    // TIME TRACKED\n    // Resolved time - Created time\n    // --------------------------------\n\n    const created = item.json.created_at;\n    const resolved = item.json.stats?.resolved_at;\n\n    if (created && resolved) {\n\n      const difference =\n        new Date(resolved).getTime() -\n        new Date(created).getTime();\n\n      if (difference >= 0) {\n\n        const totalMinutes =\n          Math.floor(difference / 60000);\n\n        const hours =\n          Math.floor(totalMinutes / 60);\n\n        const minutes =\n          totalMinutes % 60;\n\n        item.json.time_tracked =\n          String(hours).padStart(2, \"0\") +\n          \":\" +\n          String(minutes).padStart(2, \"0\");\n\n      } else {\n\n        item.json.time_tracked = \"\";\n\n      }\n\n    } else {\n\n      item.json.time_tracked = \"\";\n\n    }\n\n\n    // --------------------------------\n    // FIRST RESPONSE SLA STATUS\n    // --------------------------------\n\n    const firstResponse =\n      item.json.stats?.first_responded_at;\n\n    const firstResponseDue =\n      item.json.fr_due_by;\n\n    if (firstResponse && firstResponseDue) {\n\n      item.json.first_response_status =\n        new Date(firstResponse) <= new Date(firstResponseDue)\n            ? \"Within SLA\"\n          : \"SLA Violated\";\n\n    } else {\n\n      item.json.first_response_status = \"\";\n\n    }\n\n\n    // --------------------------------\n    // RESOLUTION SLA STATUS\n    // --------------------------------\n\n    const resolutionDue =\n      item.json.due_by;\n\n    if (resolved && resolutionDue) {\n\n      item.json.resolution_status =\n        new Date(resolved) <= new Date(resolutionDue)\n          ? \"Within SLA\"\n          : \"SLA Violated\";\n\n    } else {\n\n      item.json.resolution_status = \"\";\n\n    }\n\n\n    return item;\n\n  })\n  .sort((a, b) =>\n    new Date(a.json.created_at) -\n    new Date(b.json.created_at)\n  );\n\n\n// --------------------------------\n// TOTAL NUMBER OF TICKETS\n// --------------------------------\n\nconst totalTickets = tickets.length;\n\n\n// --------------------------------\n// RESPONSIBLE TEAM\n// --------------------------------\n\nconst dayOfWeek = new Date(\n  today + \"T12:00:00+02:00\"\n).getDay();\n\nconst teams = {\n  1: \"TEAM 1 – Pearl Mhlongo, Sandile Tshabalala\",\n  2: \"TEAM 2 – Glen Mogane, Nontokozo Simelane, Khanyisa Mathebula\",\n  3: \"TEAM 3 – Wendy Gama, Sinead Swele\",\n  4: \"TEAM 4 – Henny Mkhonto, Ncedile Bhila, Mbalenhle Zungu\",\n  5: \"TEAM 5 – Norah Moseteka, Sibusiso Peterson\"\n};\n\nconst responsibleTeam =\n  teams[dayOfWeek] || \"\";\n\n\n// --------------------------------\n// FINAL OUTPUT\n// --------------------------------\n\nreturn tickets.map((item, index) => ({\n  ...item,\n\n  json: {\n    ...item.json,\n\n    // Only first row\n    total_no_of_tickets:\n      index === 0 ? totalTickets : \"\",\n\n    // Only first row\n    responsible_team:\n      index === 0 ? responsibleTeam : \"\"\n  }\n}));"
      },
