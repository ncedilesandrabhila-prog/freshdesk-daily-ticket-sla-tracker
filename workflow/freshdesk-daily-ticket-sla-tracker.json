    {
      "parameters": {
        "jsCode": "const timeZone = \"Africa/Johannesburg\";\n\n// --------------------------------\n// GET TODAY'S DATE\n// --------------------------------\n\nconst today = new Intl.DateTimeFormat(\"en-CA\", {\n  timeZone,\n  year: \"numeric\",\n  month: \"2-digit\",\n  day: \"2-digit\"\n}).format(new Date());\n\n\n// --------------------------------\n// GET ALL FRESHDESK TICKETS\n// --------------------------------\n\nconst tickets = $input.all();\n\n\n// --------------------------------\n// FILTER TICKETS CREATED TODAY\n// --------------------------------\n\nconst todaysTickets = tickets.filter(item => {\n\n  if (!item.json.created_at) return false;\n\n  const createdDate = new Intl.DateTimeFormat(\"en-CA\", {\n    timeZone,\n    year: \"numeric\",\n    month: \"2-digit\",\n    day: \"2-digit\"\n  }).format(new Date(item.json.created_at));\n\n  return createdDate === today;\n\n});\n\nconst totalTickets = todaysTickets.length;\n\n\n// --------------------------------\n// OPEN TICKETS\n// --------------------------------\n\nconst openTickets = todaysTickets.filter(item =>\n  item.json.status === 2\n).length;\n\n\n// --------------------------------\n// OVERALL SLA COMPLIANCE\n// --------------------------------\n\n// Count tickets resolved within SLA\nconst ticketsWithinSLA = todaysTickets.filter(item => {\n\n  const resolved = item.json.stats?.resolved_at;\n  const resolutionDue = item.json.due_by;\n\n  if (!resolved || !resolutionDue) {\n    return false;\n  }\n\n  return new Date(resolved) <= new Date(resolutionDue);\n\n}).length;\n\n\n// Calculate overall SLA compliance\nlet slaCompliance;\n\nif (totalTickets === 0) {\n\n  slaCompliance = \"N/A\";\n\n} else {\n\n  slaCompliance =\n    parseFloat(\n      ((ticketsWithinSLA / totalTickets) * 100).toFixed(2)\n    ) + \"%\";\n\n}\n\n\n// --------------------------------\n// MODULE STATISTICS\n// --------------------------------\n\n// e-Leave tickets\nconst eLeaveTickets = todaysTickets.filter(item =>\n  item.json.Module === \"e-Leave\"\n);\n\nconst eLeaveTotal = eLeaveTickets.length;\n\n\n// e-Leave tickets within SLA\nconst eLeaveWithinSLA = eLeaveTickets.filter(item => {\n\n  const resolved = item.json.stats?.resolved_at;\n  const resolutionDue = item.json.due_by;\n\n  if (!resolved || !resolutionDue) {\n    return false;\n  }\n\n  return new Date(resolved) <= new Date(resolutionDue);\n\n}).length;\n\n\n// Invoice Tracking and Payments tickets\nconst invoiceTickets = todaysTickets.filter(item =>\n  item.json.Module === \"Invoice Tracking and Payments\"\n);\n\nconst invoiceTotal = invoiceTickets.length;\n\n\n// Invoice tickets within SLA\nconst invoiceWithinSLA = invoiceTickets.filter(item => {\n\n  const resolved = item.json.stats?.resolved_at;\n  const resolutionDue = item.json.due_by;\n\n  if (!resolved || !resolutionDue) {\n    return false;\n  }\n\n  return new Date(resolved) <= new Date(resolutionDue);\n\n}).length;\n\n\n// --------------------------------\n// MODULE SLA COMPLIANCE\n// --------------------------------\n\nconst eLeaveSLA =\n  eLeaveTotal === 0\n    ? \"N/A\"\n    : parseFloat(\n        ((eLeaveWithinSLA / eLeaveTotal) * 100).toFixed(2)\n      ) + \"%\";\n\n\nconst invoiceSLA =\n  invoiceTotal === 0\n    ? \"N/A\"\n    : parseFloat(\n        ((invoiceWithinSLA / invoiceTotal) * 100).toFixed(2)\n      ) + \"%\";\n\n\n// --------------------------------\n// RESPONSIBLE TEAM\n// --------------------------------\n\nconst dayOfWeek = new Date(\n  today + \"T12:00:00+02:00\"\n).getDay();\n\n\nconst teams = {\n\n  1: \"TEAM 1 – Pearl Mhlongo, Sandile Tshabalala\",\n\n  2: \"TEAM 2 – Glen Mogane, Nontokozo Simelane, Khanyisa Mathebula\",\n\n  3: \"TEAM 3 – Wendy Gama, Sinead Swele\",\n\n  4: \"TEAM 4 – Henny Mkhonto, Ncedile Bhila, Mbalenhle Zungu\",\n\n  5: \"TEAM 5 – Norah Moseteka, Sibusiso Peterson\"\n\n};\n\n\nconst responsibleTeam =\n  teams[dayOfWeek] || \"\";\n\n\n// --------------------------------\n// FINAL OUTPUT\n// --------------------------------\n\nreturn [{\n  json: {\n\n    date: today,\n\n    total_tickets_created: totalTickets,\n\n    team_responsible: responsibleTeam,\n\n    overall_ticket_sla_compliance: slaCompliance,\n\n    open_tickets: openTickets,\n\n    // Module Statistics\n    e_leave_tickets_created: eLeaveTotal,\n\n    invoice_tickets_created: invoiceTotal,\n\n    overall_e_leave_sla_compliance: eLeaveSLA,\n\n    overall_invoice_sla_compliance: invoiceSLA\n\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
